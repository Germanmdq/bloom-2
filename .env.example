# Configuración pública de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Uso exclusivo del servidor: nunca publiques esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL del sitio sin barra final
NEXT_PUBLIC_URL=http://localhost:3000

# Demo de pagos: true confirma pagos de prueba sin conectarse a Mercado Pago.
# Para cobrar de verdad, cambiala a false o eliminá esta variable.
PAYMENTS_SIMULATION=true
NEXT_PUBLIC_PAYMENTS_SIMULATION=true

# Solo necesaria cuando PAYMENTS_SIMULATION no es true.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-token-de-produccion
