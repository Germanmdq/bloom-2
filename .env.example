# Configuración pública de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Uso exclusivo del servidor: nunca publiques esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL del sitio sin barra final
NEXT_PUBLIC_URL=http://localhost:3000

# Demo de pagos: true confirma pagos de prueba sin conectarse a Mercado Pago.
# Para cobrar de verdad, cambiala a false o eliminá esta variable.
PAYMENTS_SIMULATION=true
NEXT_PUBLIC_PAYMENTS_SIMULATION=true

# Solo necesaria cuando PAYMENTS_SIMULATION no es true.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-token-de-produccion

# --- Getnet Argentina (único medio de pago online de la cuenta del cliente) ---
# El botón "Pagar" queda DESACTIVADO hasta que estas 4 variables estén cargadas.
# Documentación: https://docs.globalgetnet.com/en/products/online-payments/web-checkout
# En el Portal de Getnet configurar el webhook: https://TU-DOMINIO/api/payments/getnet/webhook
# con el mismo usuario y clave que GETNET_WEBHOOK_USER / GETNET_WEBHOOK_PASSWORD (Basic Auth).
GETNET_ENV=sandbox            # sandbox | pre | production
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_WEBHOOK_USER=
GETNET_WEBHOOK_PASSWORD=
# Datos que Getnet exige en "customer" y la cuenta del cliente no guarda (a confirmar con Getnet):
# GETNET_CUSTOMER_FALLBACK_EMAIL=pagos@tudominio.com
# GETNET_CUSTOMER_FALLBACK_DOC_TYPE=DNI
# GETNET_CUSTOMER_FALLBACK_DOC_NUMBER=
# GETNET_BILLING_STREET=
# GETNET_BILLING_NUMBER=
# GETNET_BILLING_CITY=
# GETNET_BILLING_STATE=
# GETNET_BILLING_POSTAL_CODE=
