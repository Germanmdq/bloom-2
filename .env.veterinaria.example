# ─────────────────────────────────────────────────────────────
#  Vida de Perros — variables de entorno del módulo /veterinaria
#  Copiá las que necesites a .env.local (local) o al panel del hosting.
#  NUNCA subas claves reales al repositorio.
# ─────────────────────────────────────────────────────────────

# Origen de datos: "demo" (navegador, para probar) o "supabase" (base real).
NEXT_PUBLIC_VET_DATA_SOURCE=demo

# URL pública del sitio (SEO, sitemap, links de seguimiento de pedidos).
NEXT_PUBLIC_VET_SITE_URL=https://tu-dominio.com.ar

# Supabase (ya usadas por el resto del proyecto).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # solo servidor

# Google
# NEXT_PUBLIC_VET_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VET_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_VET_GOOGLE_MAPS_KEY=              # opcional (Maps Embed API)
# NEXT_PUBLIC_VET_GOOGLE_BUSINESS_URL=https://g.page/...

# Notificaciones push (generar con: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VET_VAPID_PUBLIC_KEY=
# VET_VAPID_PRIVATE_KEY=                        # solo servidor

# Mercado Pago (cobro online): el proyecto ya incluye el SDK.
# NEXT_PUBLIC_VET_MERCADOPAGO_ENABLED=false

# Asistente con IA (opcional). Sin esto funciona con reglas.
# VET_ASSISTANT_PROVIDER=
